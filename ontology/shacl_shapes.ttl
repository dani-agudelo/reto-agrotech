# Formas SHACL para el inventario de biocontrol.
# Validan la caja de instancias (data/instancias.ttl), no las reglas SWRL.
# La humedad es opcional: un ensayo puede reportarla sin convertirla en umbral.
# tieneCondicion también es opcional cuando la fuente no trae ventana de uso.
# El estado del enlace puede ser documentado, contexto, propuesto o publicado.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix bio: <http://agrotech.ucaldas.edu.co/ontologias/biocontrol#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bio:RelacionShape a sh:NodeShape ;
    sh:targetClass bio:RelacionBiocontrol ;
    sh:property [
        sh:path bio:involucraPlaga ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class bio:Plaga ;
    ] ;
    sh:property [
        sh:path bio:involucraAgente ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class bio:AgenteBiocontrol ;
    ] ;
    sh:property [
        sh:path bio:tieneCondicion ;
        sh:maxCount 1 ;
        sh:class bio:CondicionUso ;
    ] ;
    sh:property [
        sh:path bio:fuentePrincipal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class bio:FuenteEvidencia ;
    ] ;
    sh:property [
        sh:path bio:respaldadoPor ;
        sh:minCount 1 ;
        sh:class bio:FuenteEvidencia ;
    ] ;
    sh:property [
        sh:path bio:tieneNivelEvidencia ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Alta"^^xsd:string
            "Media"^^xsd:string
            "Baja"^^xsd:string
            "Insuficiente"^^xsd:string
        ) ;
    ] .

bio:CondicionShape a sh:NodeShape ;
    sh:targetClass bio:CondicionUso ;
    sh:property [
        sh:path bio:temperaturaMin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path bio:temperaturaMax ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path bio:humedadMin ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path bio:humedadMax ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
    ] .

bio:FuenteShape a sh:NodeShape ;
    sh:targetClass bio:FuenteEvidencia ;
    sh:property [
        sh:path bio:citaCorta ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bio:titulo ;
        sh:minCount 1 ;
    ] .

bio:EnlaceExternoShape a sh:NodeShape ;
    sh:targetClass bio:AnalisisQuimico ;
    sh:property [
        sh:path bio:articuladoCon ;
        sh:minCount 1 ;
        sh:class bio:PlataformaExterna ;
    ] ;
    sh:property [
        sh:path bio:estadoEnlace ;
        sh:minCount 1 ;
        sh:in (
            "documentado"^^xsd:string
            "contexto"^^xsd:string
            "propuesto"^^xsd:string
            "publicado"^^xsd:string
        ) ;
    ] .

bio:ExperimentoEnlaceShape a sh:NodeShape ;
    sh:targetClass bio:Experimento ;
    sh:property [
        sh:path bio:articuladoCon ;
        sh:minCount 1 ;
        sh:class bio:PlataformaExterna ;
    ] ;
    sh:property [
        sh:path bio:estadoEnlace ;
        sh:minCount 1 ;
        sh:in (
            "documentado"^^xsd:string
            "contexto"^^xsd:string
            "propuesto"^^xsd:string
            "publicado"^^xsd:string
        ) ;
    ] .
