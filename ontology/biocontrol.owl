                    </swrl:ClassAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#fuentePrincipal"/>
                          <swrl:argument1 rdf:resource="urn:swrl#r"/>
                          <swrl:argument2 rdf:resource="urn:swrl#f"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:IndividualPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#involucraAgente"/>
                              <swrl:argument1 rdf:resource="urn:swrl#r"/>
                              <swrl:argument2 rdf:resource="urn:swrl#a"/>
                            </swrl:IndividualPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:IndividualPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#involucraPlaga"/>
                                  <swrl:argument1 rdf:resource="urn:swrl#r"/>
                                  <swrl:argument2 rdf:resource="urn:swrl#p"/>
                                </swrl:IndividualPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:first>
                                    <swrl:IndividualPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#potencialmenteRecomendadoPara"/>
                                      <swrl:argument1 rdf:resource="urn:swrl#a"/>
                                      <swrl:argument2 rdf:resource="urn:swrl#p"/>
                                    </swrl:IndividualPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#trazadoPor"/>
