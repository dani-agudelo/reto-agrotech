    bio:fechaConsulta "11/nov/2026" ;
    bio:informacionExtraida "Tabla de vida a 15, 20, 25, 30 y 35 °C, con 70 ± 10 % de humedad relativa. Hubo desarrollo en todas esas temperaturas y la mayor viabilidad y tasa reproductiva neta ocurrió a 25 °C."@es ;
    bio:iniciativa "Biocontroladores" ;
    bio:naturaleza "Hecho documentado (laboratorio)" ;
    bio:nivelConfiabilidad "Alta"^^xsd:string ;
