bio:Diaphorencyrtus_sp a bio:AgenteBiocontrol ;
    rdfs:label "Diaphorencyrtus aligarhensis" ;
    bio:descripcion "Endoparasitoide de Diaphorina citri. El identificador conserva Diaphorencyrtus_sp, como en reportes tempranos; Kondo et al. (2022) asignan el registro colombiano a D. aligarhensis."@es ;
    bio:nombreCientifico "Diaphorencyrtus aligarhensis" ;
    bio:nombreComun "Diaphorencyrtus aligarhensis" ;
    bio:tipoAgente "parasitoide" .

bio:Experimento a owl:Class ;
    rdfs:label "Experimento"@es ;
    rdfs:comment "Experimento, medido o propuesto, articulado con una plataforma."@es .

bio:F04 a bio:FuenteEvidencia ;
    rdfs:label "F04 - McFarland y Hoy (2001)" ;
    bio:anio 2001 ;
    bio:autores "McFarland, C. D.; Hoy, M. A." ;
    bio:citaCorta "F04 - McFarland y Hoy (2001)" ;
    bio:doi "10.2307/3496171" ;
    bio:notas "Florida Entomologist, 84(2), 227-233. Supervivencia adulta a 25 °C y 30 °C con humedades relativas de 7 %, 33 %, 53 %, 75 % y 97 %."@es ;
    bio:rolFuente "respalda_relacion" ;
    bio:tipoFuente "articulo" ;
    bio:titulo "Survival of Diaphorina citri, and its two parasitoids Tamarixia radiata and Diaphorencyrtus aligarhensis, under different relative humidities and temperature regimes" ;
    bio:url "https://doi.org/10.2307/3496171" .

bio:F06 a bio:FuenteEvidencia ;
    rdfs:label "F06 - Alemán et al. (2007)" ;
    bio:anio 2007 ;
    bio:autores "Alemán, J.; Baños, H.; Ravelo, J." ;
    bio:citaCorta "F06 - Alemán et al. (2007)" ;
    bio:notas "Revista Protección Vegetal, 22(3), 154-165. Citado por Restrepo-García et al. (2016) al señalar que el control químico puede eliminar enemigos naturales."@es ;
    bio:rolFuente "respalda_restriccion" ;
    bio:tipoFuente "articulo" ;
    bio:titulo "Diaphorina citri y la enfermedad huanglongbing: una combinación destructiva para la producción citrícola" .

bio:F08 a bio:FuenteEvidencia ;
    rdfs:label "F08 - Restrepo-García et al. (2024)" ;
    bio:anio 2024 ;
    bio:autores "Restrepo-García, A. M.; Pérez-González, O.; Soto-Giraldo, A." ;
    bio:citaCorta "F08 - Restrepo-García et al. (2024)" ;
    bio:doi "10.17151/bccm.2024.28.2.9" ;
    bio:notas "Boletín Científico Centro de Museos, 28(2), 181-190. Cepa de la Granja Montelindo. Mortalidad acumulada de 98 % en bioensayo de contacto y 3 % en el control; similitud del 98,86 % en el gen 28S."@es ;
    bio:rolFuente "respalda_relacion" ;
    bio:tipoFuente "articulo" ;
    bio:titulo "Primer aislamiento de Hirsutella citriformis en Colombia y evaluación de su patogenicidad" ;
    bio:url "https://doi.org/10.17151/bccm.2024.28.2.9" .

bio:Hirsutella_citriformis a bio:AgenteBiocontrol ;
    rdfs:label "Hirsutella citriformis" ;
    bio:descripcion "Hongo entomopatógeno aislado en la Granja Montelindo de la Universidad de Caldas y patógeno de Diaphorina citri en bioensayo de laboratorio."@es ;
    bio:nombreCientifico "Hirsutella citriformis" ;
    bio:nombreComun "Hirsutella citriformis" ;
    bio:tipoAgente "hongo_entomopatogeno" .

bio:PlagaSinAgenteDocumentado a owl:Class ;
    rdfs:label "PlagaSinAgenteDocumentado"@es ;
    rdfs:comment "Cierre de mundo local: la plaga no tiene agente en esta base."@es ;
    rdfs:subClassOf bio:Plaga .

bio:Restriccion_neonicotinoide a bio:Restriccion ;
    rdfs:label "Incompatibilidad con neonicotinoides"@es ;
    bio:codigoPractica "aplicacion_neonicotinoide" ;
    bio:descripcion "Los neonicotinoides, por ejemplo imidacloprid, interfieren con los parasitoides. En Palmira una aspersión de imidacloprid interrumpió el seguimiento de parasitismo (F05)."@es ;
    bio:etiqueta "Incompatibilidad con neonicotinoides"@es ;
    bio:justificadoPor bio:F05,
        bio:F06 .

bio:Restriccion_piretroide a bio:Restriccion ;
    rdfs:label "Incompatibilidad con piretroides"@es ;
    bio:codigoPractica "aplicacion_piretroide" ;
    bio:descripcion "Un insecticida piretroide de amplio espectro en la ventana de liberación deprime a los parasitoides. No conviene liberarlos mientras la práctica esté vigente."@es ;
    bio:etiqueta "Incompatibilidad con piretroides"@es ;
    bio:justificadoPor bio:F02,
        bio:F06 .

bio:Tamarixia_radiata a bio:AgenteBiocontrol ;
    rdfs:label "Tamarixia radiata" ;
    bio:descripcion "Ectoparasitoide de ninfas de Diaphorina citri. Es el enemigo natural con evidencia convergente en este inventario."@es ;
    bio:nombreCientifico "Tamarixia radiata" ;
    bio:nombreComun "Tamarixia radiata" ;
    bio:tipoAgente "parasitoide" .

bio:Citrus_reticulata a bio:Cultivo ;
    rdfs:label "mandarina"@es ;
    bio:descripcion "Cultivo de cítricos usado como hospedero en el inventario semilla."@es ;
    bio:nombreCientifico "Citrus reticulata" ;
    bio:nombreComun "mandarina"@es .

bio:Citrus_sinensis a bio:Cultivo ;
    rdfs:label "naranja dulce"@es ;
    bio:descripcion "Cultivo de cítricos usado como hospedero en el inventario semilla."@es ;
    bio:nombreCientifico "Citrus sinensis" ;
    bio:nombreComun "naranja dulce"@es .

bio:Diaphorina_citri a bio:Plaga ;
    rdfs:label "psílido asiático de los cítricos"@es ;
    bio:afectaA bio:Citrus_reticulata,
        bio:Citrus_sinensis ;
    bio:contextualizadoPor bio:F01,
        bio:F02,
        bio:F11 ;
    bio:descripcion "Vector del Huanglongbing (HLB). En Caldas se documentó a Tamarixia radiata alimentándose y parasitando sus ninfas."@es ;
    bio:esControladaPor bio:Diaphorencyrtus_sp,
        bio:Hirsutella_citriformis,
        bio:Tamarixia_radiata ;
    bio:nombreCientifico "Diaphorina citri" ;
    bio:nombreComun "psílido asiático de los cítricos"@es .

bio:F05 a bio:FuenteEvidencia ;
    rdfs:label "F05 - Kondo et al. (2022)" ;
    bio:anio 2022 ;
    bio:autores "Kondo, T.; Woolley, J. B.; Arciniegas, K. T.; Campos-Patiño, Y." ;
    bio:citaCorta "F05 - Kondo et al. (2022)" ;
    bio:doi "10.15446/caldasia.v44n3.95918" ;
    bio:notas "Caldasia, 44(3), 541-552. Primer reporte confirmado de la especie en Colombia (Palmira). Parasitismo de 0,3 % a 1,0 %, frente a 1,5 %–24,2 % de Tamarixia en el mismo estudio. Una aspersión de imidacloprid interrumpió el seguimiento."@es ;
    bio:rolFuente "respalda_relacion" ;
    bio:tipoFuente "articulo" ;
    bio:titulo "First report in Colombia and diagnosis of Diaphorencyrtus aligarhensis (Hymenoptera: Encyrtidae), a parasitoid wasp of Diaphorina citri" ;
    bio:url "https://doi.org/10.15446/caldasia.v44n3.95918" .

bio:F07 a bio:FuenteEvidencia ;
    rdfs:label "F07 - Pérez-González et al. (2022)" ;
    bio:anio 2022 ;
    bio:autores "Pérez-González, O.; Gómez-Flores, R.; Tamez-Guerra, P." ;
    bio:citaCorta "F07 - Pérez-González et al. (2022)" ;
    bio:doi "10.3390/jof8060573" ;
    bio:notas "Journal of Fungi, 8(6), 573. Revisión: desarrollo óptimo cerca de 25 °C, epizootias con humedad relativa superior al 80 % y precaución frente a cobre, aceite y azufre a dosis altas. El papel de los exudados sigue poco caracterizado."@es ;
    bio:rolFuente "respalda_relacion" ;
    bio:tipoFuente "articulo" ;
    bio:titulo "Insight into biological control potential of Hirsutella citriformis against Asian citrus psyllid as a vector of citrus Huanglongbing disease in America" ;
    bio:url "https://doi.org/10.3390/jof8060573" .

