bio:Diaphorina_citri a bio:Plaga ;
    rdfs:label "psílido asiático de los cítricos"@es ;
    bio:afectaA bio:Citricos ;
    bio:contextualizadoPor bio:F01,
        bio:F02,
        bio:F05 ;
    bio:descripcion "Psílido de los cítricos. En el inventario tiene parasitoides, un hongo entomopatógeno y un ensayo con Beauveria. El caldo sulfocálcico (F05) se evaluó sobre la plaga, no como restricción de los enemigos naturales."@es ;
    bio:esControladaPor bio:Beauveria_bassiana,
        bio:Diaphorencyrtus_sp,
        bio:Hirsutella_citriformis,
        bio:Tamarixia_radiata ;
    bio:nombreCientifico "Diaphorina citri" ;
    bio:nombreComun "psílido asiático de los cítricos"@es .

