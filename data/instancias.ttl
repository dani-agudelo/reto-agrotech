# Instancias y esquema del prototipo AgroTech Biocontrol.
# Generado desde data/semilla.py. Regenerar con:
#   python -m ontology.construir_ontologia
# Las ventanas numéricas son parámetros operativos del prototipo,
# anclados en las fuentes citadas, no una prescripción de campo.

@prefix bio: <http://agrotech.ucaldas.edu.co/ontologias/biocontrol#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://agrotech.ucaldas.edu.co/ontologias/biocontrol> a owl:Ontology ;
    rdfs:comment "Ontología de biocontrol de plagas de cítricos. Prototipo académico AgroTech, Universidad de Caldas. No es una prescripción agronómica."@es .

bio:Compsus_sp a bio:Plaga,
        bio:PlagaSinAgenteDocumentado ;
    rdfs:label "picudo de los cítricos"@es ;
    bio:afectaA bio:Citrus_reticulata,
        bio:Citrus_sinensis ;
    bio:descripcion "Picudo asociado a cítricos. Esta base no registra un enemigo natural. La laguna es del inventario: no afirma que no existan controladores en la literatura."@es ;
    bio:nombreCientifico "Compsus sp." ;
    bio:nombreComun "picudo de los cítricos"@es .

