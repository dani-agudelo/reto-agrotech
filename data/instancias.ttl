bio:F12 a bio:FuenteEvidencia ;
    rdfs:label "F12 - Imbachi et al. (2012)" ;
    bio:acceso "Abierto (licencia no verificada)" ;
    bio:alcance "Las plagas objetivo son ácaros, no Diaphorina citri. No sustenta que Chrysoperla controle al psílido. Región distinta a Caldas. Acta Agronómica, 61(4), 333-338."@es ;
    bio:anio 2012 ;
    bio:autores "Imbachi, K.; Mesa, N. C.; Rodríguez, I. V. et al." ;
    bio:citaCorta "F12 - Imbachi et al. (2012)" ;
    bio:fechaConsulta "11/nov/2026" ;
    bio:informacionExtraida "En naranja Valencia (Caicedonia, Valle del Cauca, 1150 msnm) la liberación de Chrysoperla carnea redujo el daño de Phyllocoptruta oleivora a 10 % en el primer ciclo. Los ácaros Phytoseiidae se dispersaron rápido de los frutos."@es ;
    bio:iniciativa "Biocontroladores" ;
    bio:naturaleza "Hecho documentado (campo)" ;
    bio:nivelConfiabilidad "Alta"^^xsd:string ;
    bio:notas "Las plagas objetivo son ácaros, no Diaphorina citri. No sustenta que Chrysoperla controle al psílido. Región distinta a Caldas. Acta Agronómica, 61(4), 333-338."@es ;
    bio:tipoFuente "Artículo científico (campo)" ;
    bio:titulo "Evaluación de estrategias de control biológico de Polyphagotarsonemus latus (Banks) y Phyllocoptruta oleivora (Ashmead) en naranja Valencia" ;
    bio:url "https://revistas.unal.edu.co/index.php/acta_agronomica/article/download/38139/40315/169692" .

