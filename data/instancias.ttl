    rdfs:label "F10 - AgroSavia (s. f.)" ;
    bio:autores "AgroSavia" ;
    bio:citaCorta "F10 - AgroSavia (s. f.)" ;
    bio:notas "Oferta tecnológica: incremento in situ, traspatios y reservorios. No es un artículo de eficacia y no aporta un porcentaje de control."@es ;
    bio:rolFuente "respalda_relacion" ;
    bio:tipoFuente "recomendacion_tecnologica" ;
