bio:Citricos a bio:Cultivo ;
    rdfs:label "cítricos"@es ;
    bio:descripcion "Hospedero citado de forma genérica en los registros de Diaphorina citri y sus parasitoides en Caldas (F01, F02). La ficha no fija la especie."@es ;
    bio:nombreCientifico "Citrus spp." ;
    bio:nombreComun "cítricos"@es .

bio:Citrus_limon a bio:Cultivo ;
    rdfs:label "limón"@es ;
    bio:descripcion "Hospedero del holotipo de Trigonospila unicaldasi en la Granja Tesorito (F04)."@es ;
    bio:nombreCientifico "Citrus limon" ;
    bio:nombreComun "limón"@es .

bio:Citrus_sinensis a bio:Cultivo ;
    rdfs:label "naranja dulce"@es ;
    bio:descripcion "Naranja Valencia del ensayo de campo en Caicedonia sobre ácaros (F12)."@es ;
    bio:nombreCientifico "Citrus sinensis" ;
    bio:nombreComun "naranja dulce"@es .

bio:ClayOMICS a bio:PlataformaExterna ;
    rdfs:label "ClayOMICS" ;
    bio:descripcion "Spin-off de la Universidad de Caldas para análisis de datos químicos. La noticia F16 acredita el servicio; la revisión F17 es del grupo de Cromatografía y no es un resultado del spin-off."@es ;
    bio:etiqueta "ClayOMICS" ;
    bio:tipoPlataforma "analisis_quimico" ;
    bio:url "https://www.ucaldas.edu.co/portal/spin-off-clayomics-de-la-universidad-de-caldas-obtiene-su-registro-de-marca/" .

bio:Compsus_sp a bio:Plaga ;
    rdfs:label "picudo de los cítricos"@es ;
    bio:afectaA bio:Citrus_limon ;
    bio:contextualizadoPor bio:F03,
        bio:F04 ;
    bio:descripcion "Picudo recolectado en Maltería y en limón de la Granja Tesorito. F03 lo trata como Compsus viridilineatus y F04 como Compsus sp."@es ;
    bio:esControladaPor bio:Trigonospila_unicaldasi ;
    bio:nombreCientifico "Compsus sp." ;
    bio:nombreComun "picudo de los cítricos"@es .

bio:Condicion_Tamarixia a bio:CondicionUso ;
    rdfs:label "15–35 °C; HR de ensayo 60–80 % (no decide)" ;
    bio:descripcionCondicion "Ventana térmica documentada por la tabla de vida de F08: desarrollo a 15, 20, 25, 30 y 35 °C, con mayor viabilidad y tasa reproductiva neta a 25 °C. F09 estudia promedios de 12 a 38 °C y no se usa como umbral de liberación. La humedad 70 ± 10 % (60-80 %) es la condición de ensayo de F08; el inventario la marca como no equivalente a un rango de viabilidad, así que no decide la recomendación."@es ;
    bio:estadoVentanaHumedad "ensayo"^^xsd:string ;
    bio:humedadMax 80.0 ;
    bio:humedadMin 60.0 ;
    bio:rangoMax 35.0 ;
    bio:rangoMin 15.0 ;
    bio:rangoValido "15–35 °C; HR de ensayo 60–80 % (no decide)" ;
    bio:temperaturaMax 35.0 ;
    bio:temperaturaMin 15.0 .

bio:Consulta a owl:Class ;
    rdfs:label "Consulta"@es ;
    rdfs:comment "Hechos temporales de una pregunta: plaga, clima y prácticas."@es .

bio:F05 a bio:FuenteEvidencia ;
    rdfs:label "F05 - Restrepo-García y Soto-Giraldo (2017)" ;
    bio:acceso "Abierto (licencia no verificada)" ;
    bio:alcance "Ensayo de laboratorio sobre la plaga. No se codifica como restricción de enemigos naturales: el inventario pide verificar ese efecto antes de usarlo en R4. Boletín Científico Centro de Museos, 21(2), 51-60."@es ;
    bio:anio 2017 ;
    bio:autores "Restrepo-García, A. M.; Soto-Giraldo, A." ;
    bio:citaCorta "F05 - Restrepo-García y Soto-Giraldo (2017)" ;
    bio:doi "10.17151/bccm.2017.21.2.4" ;
    bio:fechaConsulta "11/nov/2026" ;
