# Instancias y esquema del prototipo AgroTech Biocontrol.
# Generado desde data/semilla.py. Regenerar con:
#   python -m ontology.construir_ontologia
# Inventario F01–F17 tomado de data/inventario_fuentes.tex.
# La humedad de un ensayo no se usa como umbral si la ficha no la documenta.

@prefix bio: <http://agrotech.ucaldas.edu.co/ontologias/biocontrol#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://agrotech.ucaldas.edu.co/ontologias/biocontrol> a owl:Ontology ;
    rdfs:comment "Ontología de biocontrol de plagas de cítricos. Prototipo académico AgroTech, Universidad de Caldas. No es una prescripción agronómica."@es .

bio:Analisis_xenometabolomica a bio:AnalisisQuimico ;
    rdfs:label "Revisión de técnicas analíticas para biomarcadores de toxicidad"@es ;
    bio:articuladoCon bio:ClayOMICS ;
    bio:condicionExperimental "Revisión del tema. No es un análisis encargado a ClayOMICS ni un perfil de una cepa."@es ;
    bio:documentadoEn bio:F17 ;
    bio:estadoEnlace "contexto"^^xsd:string ;
    bio:etiqueta "Revisión de técnicas analíticas para biomarcadores de toxicidad"@es ;
    bio:resultado "F17 reseña GC-MS, LC-MS, UHPLC-QTOF-MS, RMN e ICP-MS frente a plaguicidas, metales y micotoxinas. Sirve de puente conceptual con residuos; no es un resultado del spin-off (F16)."@es ;
    bio:variableRespuesta "técnica analítica, analito y matriz"@es .

bio:Experimento_magnetico_soja a bio:Experimento ;
    rdfs:label "Campo magnético estático en germinación de soja"@es ;
    bio:articuladoCon bio:MAGNETIME ;
    bio:condicionExperimental "Semillas de soja a 125 y 300 mT durante 10, 20 y 60 min."@es ;
    bio:documentadoEn bio:F14 ;
    bio:estadoEnlace "documentado"^^xsd:string ;
    bio:etiqueta "Campo magnético estático en germinación de soja"@es ;
    bio:resultado "300 mT por 10 min redujo más el tiempo medio de germinación. La absorción de agua no cambió de forma significativa (F14). Especie: soja."@es ;
    bio:variableRespuesta "tiempo medio de germinación y absorción de agua"@es .

bio:Experimento_magnetico_tomate_comercial a bio:Experimento ;
    rdfs:label "Tratamiento magnético de semilla de tomate a escala comercial"@es ;
    bio:articuladoCon bio:MAGNETIME ;
    bio:condicionExperimental "Sistema productivo comercial de tomate. Tesis de doctorado, autor por verificar en la ficha."@es ;
    bio:documentadoEn bio:F13 ;
    bio:estadoEnlace "documentado"^^xsd:string ;
    bio:etiqueta "Tratamiento magnético de semilla de tomate a escala comercial"@es ;
    bio:resultado "El rendimiento aumentó y la floración no cambió (F13, confiabilidad media). No hay validación en cítricos."@es ;
    bio:variableRespuesta "rendimiento y floración de Solanum lycopersicum"@es .

bio:Experimento_magnetico_tomate_pregrado a bio:Experimento ;
    rdfs:label "Desarrollo vegetativo de tomate tras tratamiento magnético de la semilla"@es ;
    bio:articuladoCon bio:MAGNETIME ;
    bio:condicionExperimental "Campo magnético estático no homogéneo sobre semillas de tomate."@es ;
    bio:documentadoEn bio:F15 ;
    bio:estadoEnlace "documentado"^^xsd:string ;
    bio:etiqueta "Desarrollo vegetativo de tomate tras tratamiento magnético de la semilla"@es ;
    bio:resultado "21 % más área foliar y 9 % más altura que el control (F15, trabajo de grado). Cultivo: tomate."@es ;
    bio:variableRespuesta "área foliar y altura"@es .

bio:F16 a bio:FuenteEvidencia ;
    rdfs:label "F16 - Universidad de Caldas (2022)" ;
    bio:acceso "Abierto (web institucional)" ;
    bio:alcance "Sirve para la existencia y el alcance de los servicios, no como evidencia científica. La fecha exacta de publicación de la nota queda por completar."@es ;
    bio:anio 2022 ;
    bio:autores "Universidad de Caldas" ;
    bio:citaCorta "F16 - Universidad de Caldas (2022)" ;
    bio:fechaConsulta "11/nov/2026" ;
    bio:informacionExtraida "ClayOMICS ofrece análisis de datos químicos mediante técnicas de medición, separación e identificación. Surge del grupo de Cromatografía y Técnicas Afines y obtuvo registro de marca ante la SIC en 2022."@es ;
    bio:iniciativa "ClayOMICS" ;
    bio:naturaleza "Contexto institucional" ;
    bio:nivelConfiabilidad "Media"^^xsd:string ;
    bio:notas "Sirve para la existencia y el alcance de los servicios, no como evidencia científica. La fecha exacta de publicación de la nota queda por completar."@es ;
    bio:tipoFuente "Noticia institucional" ;
    bio:titulo "Spin Off ClayOMICs de la Universidad de Caldas obtiene su registro de marca" ;
    bio:url "https://www.ucaldas.edu.co/portal/spin-off-clayomics-de-la-universidad-de-caldas-obtiene-su-registro-de-marca/" .

bio:PlagaSinAgenteDocumentado a owl:Class ;
    rdfs:label "PlagaSinAgenteDocumentado"@es ;
    rdfs:comment "Cierre de mundo local: la plaga no tiene agente en esta base."@es ;
    rdfs:subClassOf bio:Plaga .

bio:Relacion_Compsus_Trigonospila a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_Compsus_Trigonospila" ;
    bio:condicionExperimental "Colecta en Maltería (2250 msnm) y holotipo en la Granja Tesorito (2280 m)."@es ;
    bio:criterioNivel "Alta para el hecho del parasitismo. No hay condiciones de uso ni protocolo de liberación, así que no se activa una recomendación climática."@es ;
    bio:fuentePrincipal bio:F04 ;
    bio:involucraAgente bio:Trigonospila_unicaldasi ;
    bio:involucraPlaga bio:Compsus_sp ;
    bio:respaldadoPor bio:F03,
        bio:F04 ;
    bio:resultado "Parasitismo de adultos en limón, con la especie descrita en 2017 (F04) y un estudio morfológico previo del género (F03)."@es ;
    bio:tieneNivelEvidencia "Alta"^^xsd:string ;
    bio:variableRespuesta "parasitismo de adultos de Compsus"@es .

bio:Relacion_DC_Beauveria a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Beauveria" ;
    bio:condicionExperimental "Laboratorio, cepas mexicanas Bb-Dc y Bb-Rhy."@es ;
    bio:criterioNivel "Alta para ese bioensayo. La limitación se anota aparte: no es una cepa de la Universidad de Caldas y no se extrapola a Caldas."@es ;
    bio:fuentePrincipal bio:F11 ;
    bio:involucraAgente bio:Beauveria_bassiana ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F11 ;
    bio:resultado "Sin efecto sobre huevos. Mortalidad de ninfas entre 21 y 58 % según la cepa, a 1×10^8 conidios/mL (F11)."@es ;
    bio:tieneNivelEvidencia "Alta"^^xsd:string ;
    bio:variableRespuesta "mortalidad de ninfas de Diaphorina citri"@es .

bio:Relacion_DC_Diaphorencyrtus a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Diaphorencyrtus" ;
    bio:condicionExperimental "Captura manual en brotes. Sin medición de parasitismo ni de clima de uso."@es ;
    bio:criterioNivel "Media para el control: la fuente es de confiabilidad alta, pero solo prueba presencia. El efecto sobre la plaga es una hipótesis y no hay ventana de uso."@es ;
    bio:fuentePrincipal bio:F01 ;
    bio:involucraAgente bio:Diaphorencyrtus_sp ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F01 ;
    bio:resultado "Primer registro en Colombia, en brotes de cítricos de Manizales (F01)."@es ;
    bio:tieneNivelEvidencia "Media"^^xsd:string ;
    bio:variableRespuesta "presencia del parasitoide sobre ninfas"@es .

bio:Relacion_DC_Hirsutella a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Hirsutella" ;
    bio:condicionExperimental "Bioensayo de laboratorio con la cepa de Montelindo. La incubación publicada como 25 ± 20 °C no se convierte en rango de campo."@es ;
    bio:criterioNivel "Alta para la patogenicidad de laboratorio. Sin ventana agroclimática ni ensayo de campo, así que no compite con Tamarixia en la regla climática."@es ;
    bio:fuentePrincipal bio:F07 ;
    bio:involucraAgente bio:Hirsutella_citriformis ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F07 ;
    bio:resultado "98 % de mortalidad acumulada con conidios y 3 % en el control (F07)."@es ;
    bio:tieneNivelEvidencia "Alta"^^xsd:string ;
    bio:variableRespuesta "mortalidad acumulada de Diaphorina citri"@es .

bio:Relacion_DC_Tamarixia a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Tamarixia" ;
    bio:condicionExperimental "Colecta de brotes en Caldas, enero a abril de 2016 (F02). Tabla de vida a cinco temperaturas constantes y 70 ± 10 % HR (F08)."@es ;
    bio:criterioNivel "Alta porque F02, F08 y F09 documentan la relación. La ventana de decisión es 15-35 °C. No se usa 20-30 °C ni 60-85 % HR como umbral: el inventario los marca como parcial o sin fuente."@es ;
    bio:fuentePrincipal bio:F02 ;
    bio:involucraAgente bio:Tamarixia_radiata ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F02,
        bio:F08,
        bio:F09 ;
    bio:resultado "Presencia y parasitismo en Caldas (F02). En laboratorio hay desarrollo entre 15 y 35 °C y la mayor viabilidad a 25 °C (F08). F09 amplía el estudio térmico a promedios de 12 a 38 °C."@es ;
    bio:tieneCondicion bio:Condicion_Tamarixia ;
    bio:tieneNivelEvidencia "Alta"^^xsd:string ;
    bio:tieneRestriccion bio:Restriccion_botanicos,
        bio:Restriccion_extractos ;
    bio:variableRespuesta "parasitismo de ninfas y viabilidad del desarrollo de Tamarixia radiata"@es .

bio:Relacion_PO_Chrysoperla a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_PO_Chrysoperla" ;
    bio:condicionExperimental "Campo en Caicedonia, Valle del Cauca, 1150 msnm. También se observó a Phytoseiidae."@es ;
    bio:criterioNivel "Alta para el ensayo de campo contra el ácaro. No autoriza a recomendar Chrysoperla contra Diaphorina citri ni trae una ventana numérica de temperatura."@es ;
    bio:fuentePrincipal bio:F12 ;
    bio:involucraAgente bio:Chrysoperla_carnea ;
    bio:involucraPlaga bio:Phyllocoptruta_oleivora ;
    bio:respaldadoPor bio:F12 ;
    bio:resultado "La liberación redujo el daño a 10 % en el primer ciclo, en naranja Valencia (F12)."@es ;
    bio:tieneNivelEvidencia "Alta"^^xsd:string ;
    bio:variableRespuesta "daño de Phyllocoptruta oleivora en fruto"@es .

