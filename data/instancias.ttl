bio:Analisis_exudados_Hirsutella a bio:AnalisisQuimico ;
    rdfs:label "Perfil químico propuesto de exudados de Hirsutella citriformis"@es ;
    bio:articuladoCon bio:ClayOMICS ;
    bio:condicionExperimental "No hay un protocolo ejecutado en este prototipo. La revisión F07 indica que el papel de los exudados del hongo está poco caracterizado."@es ;
    bio:estadoEnlace "propuesto"^^xsd:string ;
    bio:etiqueta "Perfil químico propuesto de exudados de Hirsutella citriformis"@es ;
    bio:resultado "Enlace de interoperabilidad propuesto con ClayOMICS (F13). El prototipo no afirma un resultado medido por esa plataforma."@es ;
    bio:variableRespuesta "exudados con actividad biológica y compatibilidad de soportes de formulación"@es .

bio:ClayOMICS a bio:PlataformaExterna ;
    rdfs:label "ClayOMICS" ;
    bio:descripcion "Spin-off de la Universidad de Caldas para análisis de datos químicos mediante técnicas de medición, separación e identificación."@es ;
    bio:etiqueta "ClayOMICS" ;
    bio:tipoPlataforma "analisis_quimico" ;
    bio:url "https://www.ucaldas.edu.co/portal/spin-off-clayomics-de-la-universidad-de-caldas-obtiene-su-registro-de-marca/" .

bio:Condicion_Diaphorencyrtus a bio:CondicionUso ;
    rdfs:label "22–32 °C; 50–90 % HR" ;
    bio:descripcionCondicion "Ventana operativa más amplia. McFarland y Hoy (2001, F04) compararon supervivencia adulta a 25 °C y 30 °C; Kondo et al. (2022, F05) confirman la especie en campo sin publicar una curva térmica propia."@es ;
    bio:humedadMax 90.0 ;
    bio:humedadMin 50.0 ;
    bio:rangoMax 32.0 ;
    bio:rangoMin 22.0 ;
    bio:rangoValido "22–32 °C; 50–90 % HR" ;
    bio:temperaturaMax 32.0 ;
    bio:temperaturaMin 22.0 .

bio:Condicion_Hirsutella a bio:CondicionUso ;
    rdfs:label "23–28 °C; 80–98 % HR" ;
    bio:descripcionCondicion "Ventana de la revisión de Pérez-González et al. (2022, F07): desarrollo óptimo cerca de 25 °C y epizootias con humedad relativa superior al 80 %, con registros de campo entre 25 °C y 28 °C. El bioensayo de 2024 (F08) demuestra patogenicidad en laboratorio, no esta ventana en Caldas."@es ;
    bio:humedadMax 98.0 ;
    bio:humedadMin 80.0 ;
    bio:rangoMax 28.0 ;
    bio:rangoMin 23.0 ;
    bio:rangoValido "23–28 °C; 80–98 % HR" ;
    bio:temperaturaMax 28.0 ;
    bio:temperaturaMin 23.0 .

bio:Condicion_Tamarixia a bio:CondicionUso ;
    rdfs:label "20–30 °C; 60–85 % HR" ;
    bio:descripcionCondicion "Ventana operativa del prototipo. Cubre el óptimo de laboratorio cercano a 25 °C y los regímenes de 25 °C y 30 °C de McFarland y Hoy (2001, F04). La humedad 60-85 % excluye los extremos secos del ensayo (7 % y 33 %) y la saturación (97 %). No es la tabla de un único experimento."@es ;
    bio:humedadMax 85.0 ;
    bio:humedadMin 60.0 ;
    bio:rangoMax 30.0 ;
    bio:rangoMin 20.0 ;
    bio:rangoValido "20–30 °C; 60–85 % HR" ;
    bio:temperaturaMax 30.0 ;
    bio:temperaturaMin 20.0 .

bio:Consulta a owl:Class ;
    rdfs:label "Consulta"@es ;
    rdfs:comment "Hechos temporales de una pregunta: plaga, clima y prácticas."@es .

bio:Experimento_campo_magnetico_conidios a bio:Experimento ;
    rdfs:label "Germinación de conidios bajo campo electromagnético"@es ;
    bio:articuladoCon bio:MAGNETIME ;
    bio:condicionExperimental "Conidios de H. citriformis en la ventana 23-28 °C y humedad relativa superior al 80 %, con y sin campo electromagnético de baja intensidad. Protocolo no ejecutado."@es ;
    bio:estadoEnlace "propuesto"^^xsd:string ;
    bio:etiqueta "Germinación de conidios bajo campo electromagnético"@es ;
    bio:resultado "Sin resultado medido. La pregunta se articula con MAGNETIME y con el semillero de Magnetobiología (F14, F15). No es un experimento realizado."@es ;
    bio:variableRespuesta "porcentaje de germinación de conidios"@es .

