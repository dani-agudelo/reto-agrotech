bio:Phyllocoptruta_oleivora a bio:Plaga,
        bio:PlagaSinAgenteDocumentado ;
    rdfs:label "ácaro tostador de los cítricos"@es ;
    bio:afectaA bio:Citrus_reticulata,
        bio:Citrus_sinensis ;
    bio:descripcion "Ácaro eriófido que daña la epidermis del fruto. Hirsutella thompsonii se discute en la literatura de ácaros, pero no se codifica en esta semilla. Por eso la consulta dispara la laguna de conocimiento de la base."@es ;
    bio:nombreCientifico "Phyllocoptruta oleivora" ;
    bio:nombreComun "ácaro tostador de los cítricos"@es .

bio:Relacion_DC_Diaphorencyrtus a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Diaphorencyrtus" ;
    bio:condicionExperimental "Conteos de momias y emergencia de adultos en un huerto de Agrosavia, Palmira, en 2020 y 2021 (F05)."@es ;
    bio:criterioNivel "Media: la especie está confirmada en Colombia, pero las tasas de campo son bajas frente a Tamarixia (F05). La regla R2 agrega precaución."@es ;
    bio:fuentePrincipal bio:F05 ;
    bio:involucraAgente bio:Diaphorencyrtus_sp ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F04,
        bio:F05 ;
    bio:resultado "Parasitismo de 0,3 % a 1,0 % en Palmira, frente a 1,5 %–24,2 % de Tamarixia en el mismo estudio (F05)."@es ;
    bio:tieneCondicion bio:Condicion_Diaphorencyrtus ;
    bio:tieneNivelEvidencia "Media"^^xsd:string ;
    bio:tieneRestriccion bio:Restriccion_neonicotinoide,
        bio:Restriccion_piretroide ;
    bio:variableRespuesta "parasitismo de ninfas de Diaphorina citri"@es .

bio:Relacion_DC_Hirsutella a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Hirsutella" ;
    bio:condicionExperimental "Bioensayo de contacto directo entre adultos de D. citri y cultivos esporulados; caracterización morfológica, morfométrica y del gen ribosomal 28S (F08)."@es ;
    bio:criterioNivel "Media: hay patogenicidad alta en laboratorio (F08) y una ventana ambiental descrita en la revisión (F07), pero el inventario no incluye un programa comercial de campo. Por eso no se asigna Alta y, si la ventana se cumple, se activa R2."@es ;
    bio:fuentePrincipal bio:F08 ;
    bio:involucraAgente bio:Hirsutella_citriformis ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F07,
        bio:F08,
        bio:F09,
        bio:F12 ;
    bio:resultado "Mortalidad acumulada de 98 % con conidios de H. citriformis y 3 % en el control; sinnemas a los 7 días post-mortem (F08)."@es ;
    bio:tieneCondicion bio:Condicion_Hirsutella ;
    bio:tieneExperimento bio:Experimento_campo_magnetico_conidios ;
    bio:tieneNivelEvidencia "Media"^^xsd:string ;
    bio:tieneRestriccion bio:Restriccion_azufre,
        bio:Restriccion_cuprico ;
    bio:variableRespuesta "mortalidad acumulada de adultos de Diaphorina citri"@es ;
    bio:verificadoPor bio:Analisis_exudados_Hirsutella .

bio:Relacion_DC_Tamarixia a bio:RelacionBiocontrol ;
    rdfs:label "Relacion_DC_Tamarixia" ;
    bio:condicionExperimental "Observación de momias y emergencia del parasitoide sobre brotes de cítricos en el Centro de Investigación y Cría de Enemigos Naturales de la Universidad de Caldas, entre enero y abril de 2016 (F02)."@es ;
    bio:criterioNivel "Alta por convergencia: reporte local de presencia y acción parasítica (F02), revisión biológica (F03), supervivencia bajo regímenes de temperatura y humedad (F04) y rutas de acceso en Colombia (F10). No es un metaanálisis de eficacia de campo."@es ;
    bio:fuentePrincipal bio:F02 ;
    bio:involucraAgente bio:Tamarixia_radiata ;
    bio:involucraPlaga bio:Diaphorina_citri ;
    bio:respaldadoPor bio:F02,
        bio:F03,
        bio:F04,
        bio:F10,
        bio:F16 ;
    bio:resultado "Presencia y acción parasítica documentadas en Caldas (F02). El inventario no codifica un porcentaje único de eficacia de campo."@es ;
    bio:tieneCondicion bio:Condicion_Tamarixia ;
    bio:tieneNivelEvidencia "Alta"^^xsd:string ;
    bio:tieneRestriccion bio:Restriccion_neonicotinoide,
        bio:Restriccion_piretroide ;
    bio:variableRespuesta "parasitismo de ninfas de Diaphorina citri"@es .

